<!-- The in-keyboard sticker panel (PRD FR-23). -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Card shown when a premium sticker pack or sticker is tapped without Pro. -->
    <string name="stickers__premium_card" tools:ignore="MissingTranslation">This pack comes with Pro</string>
    <!-- Button on the premium card. It opens the Pro screen. -->
    <string name="stickers__see_pro" tools:ignore="MissingTranslation">See Pro</string>
    <!-- Shown while a sticker pack downloads. -->
    <string name="stickers__downloading" tools:ignore="MissingTranslation">Downloading stickers…</string>
    <!-- Shown when a sticker pack did not download. -->
    <string name="stickers__download_failed" tools:ignore="MissingTranslation">The stickers did not download. Try again later.</string>
    <!-- Shown for a pack that is listed but not downloaded yet. -->
    <string name="stickers__not_installed" tools:ignore="MissingTranslation">Tap the pack to download it</string>
    <!-- Content description of one sticker. %1$d is its number in the pack. -->
    <string name="stickers__sticker" tools:ignore="MissingTranslation">Sticker %1$d</string>
    <!-- Content description of the premium badge on a pack tab. -->
    <string name="stickers__premium_badge" tools:ignore="MissingTranslation">Pro pack</string>
</resources>
