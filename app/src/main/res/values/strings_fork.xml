    <string name="ai_consent__sent_header" tools:ignore="MissingTranslation">What is sent</string>
    <string name="ai_consent__sent_ai" tools:ignore="MissingTranslation">Only when you tap ✦ or Polish: the text you selected, or the text in the field, or your dictation transcript. Never passwords or other private fields, and never what you type otherwise.</string>
