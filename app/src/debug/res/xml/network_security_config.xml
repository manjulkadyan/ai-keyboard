  Debug builds only (replaces src/main/res/xml/network_security_config.xml). Same as main, plus cleartext to a
  local kb-api for dev auth (Sprint 3 decision 6): 10.0.2.2 is the emulator's host loopback, localhost covers
  `adb reverse`. No other host may use cleartext, in any build. This build is always debuggable, so user CAs (for a
  local proxy) sit in base-config here instead of a second <debug-overrides>, which lint rejects next to main's.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
