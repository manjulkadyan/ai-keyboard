<?xml version="1.0" encoding="utf-8"?>
<!-- S4 Task 6: test APK only. EditTextHostActivity is the text field that ImeOnlyColdStartTest types into. It runs in
     the test package's own process and is exported for `am start` from the shell. It is not in the app's manifest. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="com.manjul.aikeyboard.isolation.EditTextHostActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light"
            android:windowSoftInputMode="stateAlwaysVisible"/>
        <!-- S5 Task 6: the host app's share target in StickerCompatInsertTest (the sticker share fallback). -->
        <activity
            android:name="com.manjul.aikeyboard.fork.stickers.StickerShareReceiverActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/png"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
