+        fun hostInsert(at: Int, s: String) {
+            text.insert(at, s)
+            if (cursor >= at) cursor += s.length
+            if (compStart >= at) {
+                compStart += s.length
+                compEnd += s.length
+            }
+            report()
+        }
+
         /** The host edits the field on its own (types, moves the cursor, drops the region). */
         fun hostEdit(newCursor: Int, keepRegion: Boolean) {
