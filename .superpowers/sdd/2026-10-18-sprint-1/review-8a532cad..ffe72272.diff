+        override fun clearComposing(expected: String): Boolean {
+            calls += "clear:$expected"
+            if (compStart < 0 || cursor < expected.length || text.substring(cursor - expected.length, cursor) != expected) {
+                return false
+            }
+            text.delete(compStart, compEnd)
+            cursor = compStart
+            compStart = -1
+            compEnd = -1
