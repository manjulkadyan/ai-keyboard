+      # lib/native builds all four default ABIs (no abiFilters), lib/whisper three. Require libfl_native.so
+      # and libaikb_whisper.so in each of their ABIs, because a count alone would be satisfied by other
+      # libraries (androidx ships its own .so files).
       - name: 16 KB alignment of native libraries
         run: |
           apk=app/build/outputs/apk/debug/app-debug.apk
           for abi in arm64-v8a armeabi-v7a x86 x86_64; do
             unzip -l "$apk" "lib/$abi/libfl_native.so" > /dev/null || { echo "missing lib/$abi/libfl_native.so"; exit 1; }
           done
+          for abi in arm64-v8a armeabi-v7a x86_64; do
+            unzip -l "$apk" "lib/$abi/libaikb_whisper.so" > /dev/null || { echo "missing lib/$abi/libaikb_whisper.so"; exit 1; }
+          done
           scripts/check-16kb-alignment.sh --min-libs 4 "$apk"
 
       - name: Upload reports
