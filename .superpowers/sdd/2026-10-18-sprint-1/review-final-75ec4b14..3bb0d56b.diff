+        r.controller.toggle()
+        r.engine.listener!!.onFinal("hi")
+        runCurrent()
+        val end = r.events.single { it.name == "voice_session_end" }
+        assertEquals("user", end.params["end_reason"])
+        assertFalse("error_code" in end.params)
+    }
+}
