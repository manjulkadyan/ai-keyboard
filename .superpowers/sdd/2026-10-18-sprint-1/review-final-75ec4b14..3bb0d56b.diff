+        }
+    }
+
+    buildTypes {
+        // whisper.cpp is unusably slow at -O0, so the native code is always built optimised.
+        debug {
+            externalNativeBuild {
+                cmake {
+                    arguments("-DCMAKE_BUILD_TYPE=Release")
+                }
+            }
+        }
+    }
+
+    externalNativeBuild {
+        cmake {
+            version = tools.versions.cmake.get()
+            path("src/main/cpp/CMakeLists.txt")
