+# Copyright (C) 2026 AI Keyboard contributors
+# Licensed under the Apache License, Version 2.0
+#
+# libaikb_whisper.so: the JNI bridge with whisper.cpp and ggml (CPU backend) linked in statically.
+
+cmake_minimum_required(VERSION 3.22)
+project(aikb_whisper C CXX)
+
+set(WHISPER_DIR ${CMAKE_CURRENT_SOURCE_DIR}/../../../third_party/whisper.cpp)
+
+# whisper.cpp / ggml options: one static CPU-only build, no tests/examples/server.
+set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
+set(WHISPER_BUILD_TESTS OFF CACHE BOOL "" FORCE)
+set(WHISPER_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
+set(WHISPER_BUILD_SERVER OFF CACHE BOOL "" FORCE)
+set(WHISPER_ALL_WARNINGS OFF CACHE BOOL "" FORCE)
+set(GGML_NATIVE OFF CACHE BOOL "" FORCE)
+set(GGML_BACKEND_DL OFF CACHE BOOL "" FORCE)
+set(GGML_CPU_ALL_VARIANTS OFF CACHE BOOL "" FORCE)
+# ggml's own thread pool; OpenMP would need libomp.so packaged next to us.
+set(GGML_OPENMP OFF CACHE BOOL "" FORCE)
+set(GGML_LLAMAFILE OFF CACHE BOOL "" FORCE)
+# arm64 stays on the armv8-a baseline (+ the NEON every arm64 core has). armv8.2-a+fp16+dotprod would
+# need runtime CPU dispatch, which ggml only offers as GGML_CPU_ALL_VARIANTS with dlopen'ed backend
+# libraries (GGML_BACKEND_DL); a single .so compiled for v8.2 would SIGILL on Cortex-A53/A73 phones.
+set(GGML_CPU_ARM_ARCH "" CACHE STRING "" FORCE)
+
+add_subdirectory(${WHISPER_DIR} whisper.cpp EXCLUDE_FROM_ALL)
+
+foreach(lib ggml ggml-base ggml-cpu whisper)
+    # -Wno-format: upstream printf-format warnings in code we do not edit.
+    target_compile_options(${lib} PRIVATE -O3 -ffunction-sections -fdata-sections -Wno-format)
+endforeach()
+
+add_library(aikb_whisper SHARED whisper_jni.cpp)
+target_compile_options(aikb_whisper PRIVATE -O3 -fvisibility=hidden -Wall -Wextra)
+target_link_libraries(aikb_whisper PRIVATE whisper ggml)
+target_link_options(aikb_whisper PRIVATE
+    # 16 KB page sizes (Android 15+, TRD §11.8): every LOAD segment aligned to 16 KB.
+    -Wl,-z,max-page-size=16384
+    -Wl,-z,common-page-size=16384
+    -Wl,--gc-sections
+    -Wl,--exclude-libs,ALL
+)
diff --git a/lib/whisper/src/main/cpp/whisper_jni.cpp b/lib/whisper/src/main/cpp/whisper_jni.cpp
new file mode 100644
index 00000000..8946f3d2
--- /dev/null
+++ b/lib/whisper/src/main/cpp/whisper_jni.cpp
@@ -0,0 +1,133 @@
+/*
+ * Copyright (C) 2026 AI Keyboard contributors
+ * Licensed under the Apache License, Version 2.0
+ */
+
+// JNI bridge for com.manjul.aikeyboard.lib.whisper.WhisperJni. Input guards (handle ids, empty PCM,
+// double free, free during a decode) are in Kotlin (WhisperBridge); this file only marshals and calls
+// whisper.cpp. Text goes back as raw UTF-8 bytes: whisper output can be malformed or contain 4-byte
+// sequences, which are not modified UTF-8 and would abort the process in NewStringUTF under CheckJNI.
+// Nothing here logs: whisper.cpp's log output is discarded so no transcript text reaches any log.
+
+#include <jni.h>
+
+#include <atomic>
+#include <cstdint>
+#include <new>
+#include <string>
+
+#include "whisper.h"
+
+namespace {
+
+// What a Kotlin handle points to.
+struct Session {
+    whisper_context *ctx;
+    int threads;
+    // Set by nativeAbort from another thread, polled by whisper_full. Never reset: an aborted session is freed.
+    std::atomic<bool> abort_requested{false};
+};
+
+bool should_abort(void *user_data) {
+    return static_cast<Session *>(user_data)->abort_requested.load(std::memory_order_relaxed);
+}
+
+void discard_log(enum ggml_log_level, const char *, void *) {}
+
+Session *to_session(jlong handle) {
+    return reinterpret_cast<Session *>(static_cast<intptr_t>(handle));
+}
+
+}  // namespace
+
+extern "C" JNIEXPORT jlong JNICALL
+Java_com_manjul_aikeyboard_lib_whisper_WhisperJni_nativeInit(
+        JNIEnv *env, jclass, jstring model_path, jint threads) {
+    whisper_log_set(discard_log, nullptr);
+
+    const char *path = env->GetStringUTFChars(model_path, nullptr);
+    if (path == nullptr) return 0;  // OutOfMemoryError pending
+
+    whisper_context_params cparams = whisper_context_default_params();
+    cparams.use_gpu = false;
+    whisper_context *ctx = whisper_init_from_file_with_params(path, cparams);
+    env->ReleaseStringUTFChars(model_path, path);
+    if (ctx == nullptr) return 0;
+
+    auto *session = new (std::nothrow) Session;
+    if (session != nullptr) {
+        session->ctx = ctx;
+        session->threads = threads;
+    }
+    if (session == nullptr) {
+        whisper_free(ctx);
+        return 0;
+    }
+    return static_cast<jlong>(reinterpret_cast<intptr_t>(session));
+}
+
+extern "C" JNIEXPORT jbyteArray JNICALL
+Java_com_manjul_aikeyboard_lib_whisper_WhisperJni_nativeTranscribe(
+        JNIEnv *env, jclass, jlong handle, jfloatArray pcm, jstring lang, jboolean translate) {
+    Session *session = to_session(handle);
+    if (session == nullptr) {
+        jclass ise = env->FindClass("java/lang/IllegalStateException");
+        if (ise != nullptr) env->ThrowNew(ise, "null whisper session");
+        return nullptr;
+    }
+
+    const char *lang_chars = env->GetStringUTFChars(lang, nullptr);
+    if (lang_chars == nullptr) return nullptr;
+    const std::string language(lang_chars);
+    env->ReleaseStringUTFChars(lang, lang_chars);
+    if (language != "auto" && whisper_lang_id(language.c_str()) < 0) return nullptr;
+
+    whisper_full_params params = whisper_full_default_params(WHISPER_SAMPLING_GREEDY);
+    params.n_threads = session->threads;
+    params.language = language.c_str();
+    params.translate = translate == JNI_TRUE;
+    params.no_timestamps = true;
+    params.single_segment = false;
+    params.print_special = false;
+    params.print_progress = false;
+    params.print_realtime = false;
+    params.print_timestamps = false;
+    // suppress_blank stays at its default (true); also drop non-speech tokens ("[BLANK_AUDIO]", "(music)").
+    params.suppress_nst = true;
+    params.abort_callback = should_abort;
+    params.abort_callback_user_data = session;
+
+    // Not GetPrimitiveArrayCritical: whisper_full runs for seconds and must not block the GC.
+    const jsize n_samples = env->GetArrayLength(pcm);
+    jfloat *samples = env->GetFloatArrayElements(pcm, nullptr);
+    if (samples == nullptr) return nullptr;
+    const int rc = whisper_full(session->ctx, params, samples, n_samples);
+    env->ReleaseFloatArrayElements(pcm, samples, JNI_ABORT);
+    if (rc != 0 || session->abort_requested.load()) return nullptr;
+
+    std::string text;
+    const int n_segments = whisper_full_n_segments(session->ctx);
+    for (int i = 0; i < n_segments; ++i) {
+        const char *segment = whisper_full_get_segment_text(session->ctx, i);
+        if (segment != nullptr) text += segment;
+    }
+    jbyteArray bytes = env->NewByteArray(static_cast<jsize>(text.size()));
+    if (bytes == nullptr) return nullptr;  // OutOfMemoryError pending
+    env->SetByteArrayRegion(bytes, 0, static_cast<jsize>(text.size()),
+                            reinterpret_cast<const jbyte *>(text.data()));
+    return bytes;
+}
+
+extern "C" JNIEXPORT void JNICALL
+Java_com_manjul_aikeyboard_lib_whisper_WhisperJni_nativeAbort(JNIEnv *, jclass, jlong handle) {
+    Session *session = to_session(handle);
+    if (session != nullptr) session->abort_requested.store(true);
+}
+
+extern "C" JNIEXPORT void JNICALL
+Java_com_manjul_aikeyboard_lib_whisper_WhisperJni_nativeFree(JNIEnv *, jclass, jlong handle) {
+    Session *session = to_session(handle);
+    if (session == nullptr) return;
+    whisper_free(session->ctx);
+    delete session;
+}
